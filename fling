-- 2. XỬ LÝ LOGIC FLING
-- ==========================================
local isFlingEnabled = true
local flingSpeed = 850
local bodyVelocities = {}

speedInput:GetPropertyChangedSignal("Text"):Connect(function()
	local numericText = speedInput.Text:gsub("%D", "")
	if numericText ~= "" then
		local num = tonumber(numericText)
		if num > 5000 then num = 5000 end
		flingSpeed = num
		speedInput.Text = tostring(num)
	else
		flingSpeed = 0
	end
	updateAllBodyVelocities()
end)

local function toggleFling()
	isFlingEnabled = not isFlingEnabled
	if isFlingEnabled then
		toggleFlingBtn.Text = "Fling: ON [2]"
		toggleFlingBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
	else
		toggleFlingBtn.Text = "Fling: OFF [2]"
		toggleFlingBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
	end
	updateAllBodyVelocities()
end

toggleFlingBtn.MouseButton1Click:Connect(toggleFling)

-- Xử lý GrabParts
local function handleGrabPart(grabPart)
	if not grabPart then return end
	
	local weldConstraint = grabPart:FindFirstChild("WeldConstraint")
	if not weldConstraint or not weldConstraint.Part1 then return end
	
	local targetPart = weldConstraint.Part1
	if not targetPart then return end
	
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	
	if isFlingEnabled then
		bodyVelocity.Velocity = Workspace.CurrentCamera.CFrame.LookVector * flingSpeed
	end
	
	bodyVelocity.Parent = targetPart
	table.insert(bodyVelocities, bodyVelocity)
	Debris:AddItem(bodyVelocity, 100)
	
	return bodyVelocity
end

local function setupGrabPartsListener()
	local grabPartsFolder = Workspace:FindFirstChild("GrabParts")
	if not grabPartsFolder then return end
	
	grabPartsFolder.ChildAdded:Connect(function(child)
		if child.Name == "GrabPart" then
			task.wait(0.1)
			handleGrabPart(child)
		end
	end)
	
	for _, child in ipairs(grabPartsFolder:GetChildren()) do
		if child.Name == "GrabPart" then
			handleGrabPart(child)
		end
	end
end

local function watchForGrabParts()
	local connection
	
	local function checkGrabParts()
		local grabPartsFolder = Workspace:FindFirstChild("GrabParts")
		if grabPartsFolder then
			if connection then
				connection:Disconnect()
				connection = nil
			end
			setupGrabPartsListener()
		end
	end
	
	checkGrabParts()
	
	connection = Workspace.ChildAdded:Connect(function(child)
		if child.Name == "GrabParts" then
			checkGrabParts()
		end
	end)
end

watchForGrabParts()

local function updateAllBodyVelocities()
	local lookVector = Workspace.CurrentCamera.CFrame.LookVector
	
	for _, bv in ipairs(bodyVelocities) do
		if bv and bv.Parent then
			if isFlingEnabled and flingSpeed > 0 then
				bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
				bv.Velocity = lookVector * flingSpeed
			else
				bv.MaxForce = Vector3.zero
			end
		end
	end
end

