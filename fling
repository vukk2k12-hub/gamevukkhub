local isMenuOpen = false

-- Hàm toggle menu với giải phóng chuột
local function toggleMenu()
    isMenuOpen = not isMenuOpen
    mainFrame.Visible = isMenuOpen
    
    if isMenuOpen then
        -- Mở menu và thả chuột
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
        
        -- Animation mở
        mainFrame.Size = UDim2.new(0, 0, 0, 0)
        wait(0.05)
        mainFrame.Size = UDim2.new(0, 280, 0, 350)
    else
        -- Đóng menu và khóa chuột lại
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
        UserInputService.MouseIconEnabled = false
    end
end

-- Click vào bất kỳ đâu trên menu để giữ chuột
mainFrame.MouseEnter:Connect(function()
    if isMenuOpen then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end
end)

-- Khi rời khỏi menu thì khóa chuột lại (tùy chọn)
mainFrame.MouseLeave:Connect(function()
    -- Không tự động khóa để user có thể click thoải mái
end)

-- Mở menu khi click nút menu
menuButton.MouseButton1Click:Connect(function()
    toggleMenu()
end)

-- Phím tắt: M để mở menu
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.M then
        toggleMenu()
    end
    
    if input.KeyCode == Enum.KeyCode.Escape and isMenuOpen then
        toggleMenu()
    end
end)

-- Đóng menu
closeButton.MouseButton1Click:Connect(function()
    if isMenuOpen then toggleMenu() end
end)

-- Tự động bắt sự kiện khi menu mở để giữ chuột
UserInputService.InputBegan:Connect(function(input)
    if isMenuOpen and input.UserInputType == Enum.UserInputType.MouseButton1 then
        -- Giữ chuột ở trạng thái tự do khi click vào menu
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end
end)

-- ==========================================
-- LOGIC FLING
-- ==========================================

local isFlingEnabled = true
local flingSpeed = 850

toggleButton.MouseButton1Click:Connect(function()
    isFlingEnabled = not isFlingEnabled
    toggleButton.Text = isFlingEnabled and "🔘 Fling: ON" or "🔘 Fling: OFF"
    toggleButton.BackgroundColor3 = isFlingEnabled and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(80, 80, 80)
end)

speedInput:GetPropertyChangedSignal("Text"):Connect(function()
    local numericText = speedInput.Text:gsub("%D", "")
    if numericText ~= "" then
        local value = tonumber(numericText)
        if value and value > 0 then
            flingSpeed = value
            speedInput.Text = tostring(value)
        else
            flingSpeed = 850
            speedInput.Text = "850"
        end
    else
        flingSpeed = 850
        speedInput.Text = "850"
    end
end)

resetButton.MouseButton1Click:Connect(function()
    isFlingEnabled = true
    flingSpeed = 850
    toggleButton.Text = "🔘 Fling: ON"
    toggleButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    speedInput.Text = "850"
    print("✨ Settings reset to default!")
end)

-- ==========================================
-- LOGIC FLING
-- ==========================================

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "GrabParts" then
        local grabPart = child:FindFirstChild("GrabPart")
        if not grabPart then return end
        
        local weldConstraint = grabPart:FindFirstChild("WeldConstraint")
        if weldConstraint and weldConstraint.Part1 then
            local targetPart = weldConstraint.Part1
            
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Parent = targetPart
            bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            
            local connection
            connection = game:GetService("RunService").Heartbeat:Connect(function()
                if not targetPart.Parent or not isFlingEnabled then
                    if connection then connection:Disconnect() end
                    return
                end
                if Workspace.CurrentCamera then
                    local lookVector = Workspace.CurrentCamera.CFrame.LookVector
                    bodyVelocity.Velocity = lookVector * flingSpeed
                end
            end)
            
            Debris:AddItem(bodyVelocity, 3)
            
            child:GetPropertyChangedSignal("Parent"):Connect(function()
                if not child.Parent then
                    if connection then connection:Disconnect() end
                end
            end)
        end
    end
end)

