-- 5. DỌN DẸP KHI ĐÓNG MENU
-- ==========================================
closeButton.MouseButton1Click:Connect(function()
	if isAntiGrabEnabled then
		toggleAntiGrab()
	end
	
	isFlingEnabled = false
	
	for _, bv in ipairs(bodyVelocities) do
		if bv then
			bv:Destroy()
		end
	end
	bodyVelocities = {}
	
	if antiGrabLoop then
		antiGrabLoop:Disconnect()
		antiGrabLoop = nil
	end
	
	screenGui:Destroy()
end)

-- Xử lý khi nhân vật respawn
local function onCharacterAdded(character)
	for _, bv in ipairs(bodyVelocities) do
		if bv then
			bv:Destroy()
		end
	end
	bodyVelocities = {}
	
	task.wait(1)
	watchForGrabParts()
end

localPlayer.CharacterAdded:Connect(onCharacterAdded)

