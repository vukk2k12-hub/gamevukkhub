-- Vòng lặp cập nhật vị trí Vòng Tròn bám theo bạn
RunService.RenderStepped:Connect(function()
    if ShowMyFov and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myHrp = LocalPlayer.Character.HumanoidRootPart
        if AimDistanceFOV > 0 then
            local ringSize = AimDistanceFOV * 2 
            MyGroundRing.Size = Vector3.new(0.1, ringSize, ringSize)
            MyGroundRing.CFrame = CFrame.new(myHrp.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
            toggleMyRing(true)
        else
            toggleMyRing(false)
        end
    else
        toggleMyRing(false)
    end
end)

-- ==========================================
-- TAB 2: ESP LOGIC (Cũng tự động ẩn dòng kẻ/khung nếu cùng team khi bật Check Team)
-- ==========================================
local function createEsp(player)
    local box = Drawing.new("Square")
    box.Visible = false; box.Color = Color3.fromRGB(0, 162, 255); box.Thickness = 1.5; box.Filled = false
    local text = Drawing.new("Text")
    text.Visible = false; text.Color = Color3.fromRGB(255, 255, 255); text.Size = 14; text.Center = true
    local line = Drawing.new("Line")
    line.Visible = false; line.Color = Color3.fromRGB(0, 162, 255); line.Thickness = 1; line.Transparency = 0.6
    Cache[player] = {Box = box, Text = text, Line = line}
end

local function removeEsp(player)
    if Cache[player] then
        Cache[player].Box:Remove(); Cache[player].Text:Remove(); Cache[player].Line:Remove()
        Cache[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then createEsp(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then createEsp(p) end end)
Players.PlayerRemoving:Connect(function(p) removeEsp(p) end)

RunService.RenderStepped:Connect(function()
    local Camera = workspace.CurrentCamera
    for player, drawings in pairs(Cache) do
        if EspEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            -- Nếu bật Check Team và người này là đồng đội -> Ẩn ESP đi để đỡ rối mắt
            if isTeammate(player) then
                drawings.Box.Visible = false; drawings.Text.Visible = false; drawings.Line.Visible = false
                continue
            end

            local hrp = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                local sizeX = 1000 / distance
                local sizeY = 1500 / distance
                drawings.Box.Size = Vector2.new(sizeX, sizeY)
                drawings.Box.Position = Vector2.new(screenPos.X - sizeX / 2, screenPos.Y - sizeY / 2)
                drawings.Box.Visible = true
                drawings.Text.Text = string.format("[ %d m ]", math.floor(distance))
                drawings.Text.Position = Vector2.new(screenPos.X + (sizeX / 2) + 15, screenPos.Y - 7)
                drawings.Text.Visible = true
                drawings.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                drawings.Line.To = Vector2.new(screenPos.X, screenPos.Y + (sizeY / 2))
                drawings.Line.Visible = true
                continue
            end
        end
        drawings.Box.Visible = false; drawings.Text.Visible = false; drawings.Line.Visible = false
    end
end)

