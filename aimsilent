    uiStroke.Parent = instance

    -- Tạo luồng hiệu ứng nhịp đập
    task.spawn(function()
        while instance and instance.Parent do
            if not instance or not instance.Parent then break end
            uiStroke.Thickness = 1.5 + (math.sin(tick() * 5) * 1.5)
            task.wait(0.02)
        end
    end)
end

