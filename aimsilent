-- [[ CORE MECHANICAL LOGIC: BACKEND HOOKS ]]
local function getClosestPlayer()
    local target = nil
    local maxDist = getgenv().Config.RangeValue
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if getgenv().Config.CheckTeam and v.Team == lp.Team then continue end
            
            local screenPos, onScreen = camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if onScreen then
                local mousePos = UIS:GetMouseLocation()
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < maxDist then
                    maxDist = dist
                    target = v
                end
            end
        end
    end
    return target
end

local mt = getrawmetatable(game)
local oldIndex = mt.__index
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__index = newcclosure(function(self, key)
    if not checkcaller() and getgenv().Config.SilentAim and tostring(self) == "Mouse" and key == "Hit" then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            return target.Character.HumanoidRootPart.CFrame
        end
    end
    return oldIndex(self, key)
end)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and getgenv().Config.SilentAim and (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "Raycast") then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            return target.Character.HumanoidRootPart, target.Character.HumanoidRootPart.Position
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)


-- [[ VISUAL RENDERING: DRAWING API (ESP & RANGE) ]]
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.Color = Color3.fromRGB(135, 206, 250)
fovCircle.Filled = false
fovCircle.Transparency = 0.6

local espCache = {}

local function createEspDrawings()
    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Filled = false
    box.Visible = false
    
    local line = Drawing.new("Line")
    line.Thickness = 1
    line.Color = Color3.fromRGB(135, 206, 250)
    line.Visible = false
    
    local text = Drawing.new("Text")
    text.Size = 14
    text.Center = true
    text.Outline = true
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Visible = false

    return {Box = box, Line = line, Text = text}
end

RunService.RenderStepped:Connect(function()
    if getgenv().Config.ShowRange then
        fovCircle.Radius = getgenv().Config.RangeValue
        fovCircle.Position = UIS:GetMouseLocation()
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p == lp then continue end
        if not espCache[p] then espCache[p] = createEspDrawings() end
        
        local drawings = espCache[p]
        local isVisible = false
        
        if getgenv().Config.ESP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            if not (getgenv().Config.CheckTeam and p.Team == lp.Team) then
                local hrp = p.Character.HumanoidRootPart
                local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    local scale = 1 / (hrpPos.Z * math.tan(math.rad(camera.FieldOfView * 0.5))) * 1000
                    local w, h = 2.5 * scale, 4.5 * scale
                    
                    drawings.Box.Size = Vector2.new(w, h)
                    drawings.Box.Position = Vector2.new(hrpPos.X - w/2, hrpPos.Y - h/2)
                    drawings.Box.Visible = true
                    
                    drawings.Line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    drawings.Line.To = Vector2.new(hrpPos.X, hrpPos.Y + h/2)
                    drawings.Line.Visible = true
                    
                    local distance = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                    drawings.Text.Text = p.Name .. " [" .. tostring(distance) .. "m]"
                    drawings.Text.Position = Vector2.new(hrpPos.X, hrpPos.Y - h/2 - 18)
                    drawings.Text.Visible = true
                    
                    isVisible = true
                end
            end
        end
        
        if not isVisible then
            drawings.Box.Visible = false
            drawings.Line.Visible = false
            drawings.Text.Visible = false
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if espCache[p] then
        espCache[p].Box:Remove()
        espCache[p].Line:Remove()
        espCache[p].Text:Remove()
        espCache[p] = nil
    end
