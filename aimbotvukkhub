-- HOOK TEAM SERVER
-- ============================================================
local serverTeamMap = {}
local myServerTeam = nil

local function hookTeamEvent()
    local rs = game:GetService("ReplicatedStorage")
    local events = rs:FindFirstChild("EventsNew")
    if not events then return end
    local playerFolder = events:FindFirstChild("Player")
    if not playerFolder then return end
    local ev = playerFolder:FindFirstChild("TeamSelected_R")
    if not ev then return end

    ev.OnClientEvent:Connect(function(plr, teamNum)
        if typeof(plr) == "Instance" and plr:IsA("Player") then
            serverTeamMap[plr.UserId] = teamNum
            if plr == player then myServerTeam = teamNum end
        end
    end)
end

task.spawn(function()
    for _ = 1, 20 do
        hookTeamEvent()
        task.wait(1)
    end
end)

-- ============================================================
-- CHECK TEAM (gộp Team + TeamNum + Server + IconTeamMate DoW)
-- ============================================================
local function hasTeamIcon(inst)
    local char = inst
    if inst:IsA("Player") then
        char = inst.Character
    end
    if not char then return false end
    local ui = char:FindFirstChild("UI_AlwaysVisible")
    if not ui then return false end
    local icon = ui:FindFirstChild("IconTeamMate", true)
    if icon and icon.Visible then return true end
    return false
end

local function isSameTeam(a, b)
    if not a or not b then return false end

    -- 1) Team property
    if a.Team and b.Team and a.Team == b.Team then return true end

    -- 2) TeamNum attribute
    local aNum = a:GetAttribute("TeamNum")
    local bNum = b:GetAttribute("TeamNum")
    if aNum and bNum and aNum == bNum then return true end

    -- 3) Server hook (TeamSelected_R)
    local aSrv = a:IsA("Player") and serverTeamMap[a.UserId] or nil
    local bSrv = b:IsA("Player") and serverTeamMap[b.UserId] or nil
    if aSrv and bSrv and aSrv == bSrv then return true end

    -- 4) CÁCH CỦA DOW: IconTeamMate
    if hasTeamIcon(a) or hasTeamIcon(b) then return true end

    return false
end

-- ============================================================
-- SILENT AIM (ép 100% Head/Body, bắn tay, FOV chung)
-- ============================================================
local function setupSilentAim()
    if silentAimReady then return true end
    if not (hookfunction and require) then
        warn("[SilentAim] Executor thiếu hookfunction/require")
        return false
    end

    local ok, dmg = pcall(require, RF.src.Util.Damage)
    if not ok then
        warn("[SilentAim] Không require được Damage: " .. tostring(dmg))
        return false
    end

    local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled and not UIS.MouseEnabled

    local rp = RaycastParams.new()
    rp.CollisionGroup = "shoot"
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true

    local function isVisible(part)
        local char = player.Character
        if not (char and part) then return false end

        local camPos = Camera.CFrame.Position
        rp.FilterDescendantsInstances = {char}
        local dir = part.Position - camPos
        local result = Workspace:Raycast(camPos, dir, rp)
        if not result then return true end
        if result.Instance:IsDescendantOf(part.Parent) then
            return true
        end
        return false
    end

    local function getTarget(origin)
        local cPart, cDistance = nil, currentFOV
        for _, plr in next, Players:GetPlayers() do
            if plr == player then continue end
            local char = plr.Character
            if not char
                or char:FindFirstChildOfClass("ForceField")
                or (char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0)
            then continue end

            -- Check team/friend theo menu (gộp IconTeamMate)
            local skip = false
            if friendCheck and player:IsFriendsWith(plr.UserId) then skip = true end
            if not skip and teamCheck and isSameTeam(player, plr) then skip = true end
            if skip then continue end

            -- CHỈ chọn đúng part theo mode, KHÔNG fallback
            local tPart
            if silentPartMode == "Body" then
                tPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            else
                tPart = char:FindFirstChild("Head")
            end
            if not tPart then continue end

            local pos, onScreen = Camera:WorldToViewportPoint(tPart.Position)
            if not onScreen then continue end

            if not isVisible(tPart) then continue end

            local distance = (Vector2.new(pos.X, pos.Y)
                - (isMobile and Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) or UIS:GetMouseLocation())).Magnitude
            if distance < cDistance then
                cPart = tPart
                cDistance = distance
            end
        end
        return cPart
    end

    rawset(dmg, "GetYaw", function() return 0 end)
    rawset(dmg, "GetPitch", function() return 0 end)

    local old
    old = clonefunction(hookfunction(rawget(dmg, "CheckShoot"), newcclosure(function(origin, plr, ...)
        if plr and plr == player then
            local oPos = origin.Position
            local c = getTarget(oPos)
            if c and c.Parent and c.Parent:FindFirstChild("Humanoid") then
                local isHead = (silentPartMode == "Head")
                local dir = c.Position - oPos
                return {
                    ["instance"] = c,
                    ["finalPosition"] = c.Position,
                    ["normal"] = -dir.Unit,
                    ["bulletDirection"] = dir,
                    ["headshot"] = isHead,
                    ["victimCha"] = c.Parent,
                    ["victimHum"] = c.Parent.Humanoid,
                    ["hitPart"] = c,
                    ["hitPartName"] = isHead and "Head" or "Body",
                }
            end
        end
        return old(origin, plr, ...)
    end)))

    silentAimReady = true
    silentGetTarget = getTarget
    print("[SilentAim] Ready — mode: " .. silentPartMode)
    return true
end

