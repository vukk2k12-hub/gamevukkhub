    -- ============================================================
    -- CHECK WALL
    -- ============================================================
    local function buildIgnoreList(targetHead)
        local ignore = {}
        if player.Character then table.insert(ignore, player.Character) end
        if targetHead and targetHead.Parent then table.insert(ignore, targetHead.Parent) end
        return ignore
    end

    local function canSee(targetHead)
        if not wallCheck then return true end
        if not targetHead then return false end

        local origin = Camera.CFrame.Position
        local dir = targetHead.Position - origin
        local distance = dir.Magnitude
        if distance <= 0 then return true end
        dir = dir.Unit

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        rayParams.FilterDescendantsInstances = buildIgnoreList(targetHead)

        local ray = Workspace:Raycast(origin, dir * distance, rayParams)
        if not ray or not ray.Instance then return true end

        local hit = ray.Instance
        if targetHead.Parent and hit:IsDescendantOf(targetHead.Parent) then return true end
        if hit:IsA("BasePart") or hit:IsA("Terrain") then return false end
        return false
    end

    local function withinAimRange(head)
        if not player.Character or not player.Character:FindFirstChild("Head") then
            return false
        end
        local d = (player.Character.Head.Position - head.Position).Magnitude
        if aimRange == 0 then return true end
        return d <= aimRange
    end

    local function getClosestTarget()
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local fov = currentFOV
        aimRange = tonumber(DistanceBox.Text) or 0

        if priorityTarget and priorityTarget.Character then
            local head = priorityTarget.Character:FindFirstChild("Head")
            local hum = priorityTarget.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist2d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist2d <= fov and canSee(head) and withinAimRange(head) then
                        return priorityTarget
                    end
                end
            end
        end

        local closest, shortest = nil, math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local skip = false
                    if friendCheck and player:IsFriendsWith(plr.UserId) then skip = true end
                    if not skip and teamCheck and isSameTeam(player, plr) then skip = true end

                    if not skip then
                        local head = plr.Character.Head
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if dist2d <= fov and dist2d < shortest and canSee(head) and withinAimRange(head) then
                                shortest = dist2d
                                closest = plr
                            end
                        end
                    end
                end
            end
        end

        if closest then return closest end

        if aimNPC then
            local closestNPC, shortestNPC = nil, math.huge
            for _, npc in pairs(Workspace:GetDescendants()) do
                if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc:FindFirstChild("Head") then
                    if Players:GetPlayerFromCharacter(npc) == nil then
                        local hum = npc.Humanoid
                        if hum.Health > 0 then
                            local skip = false
                            if teamCheck and isSameTeam(player, npc) then skip = true end
                            if not skip then
                                local head = npc.Head
                                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                                if onScreen then
                                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                    if dist <= fov and dist < shortestNPC and canSee(head) and withinAimRange(head) then
                                        shortestNPC = dist
                                        closestNPC = npc
                                    end
                                end
                            end
                        end
                    end
                end
            end
            return closestNPC
        end

        return nil
    end

    -- ============================================================
    -- MAIN LOOP
    -- ============================================================
    RunService.RenderStepped:Connect(function()
        currentFOV = tonumber(FOVBox.Text) or 100
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FOVCircle.Radius = currentFOV

        if espOn then
            espDistance = tonumber(ESPDistBox.Text) or 100
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        if not espLines[plr] then
                            espLines[plr] = Drawing.new("Line")
                            espLines[plr].Thickness = 2
                        end
                        local head = plr.Character.Head
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        local line = espLines[plr]
                        if player.Character and player.Character:FindFirstChild("Head") then
                            local dist = (player.Character.Head.Position - head.Position).Magnitude
                            if onScreen and dist <= espDistance then
                                line.Visible = true
                                line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                                line.To = Vector2.new(screenPos.X, screenPos.Y)
                                if player:IsFriendsWith(plr.UserId) then
                                    line.Color = Color3.fromRGB(0,255,0)
                                else
                                    line.Color = Color3.fromRGB(135,206,250)
                                end
                            else
                                line.Visible = false
                            end
                        end
                    end
                end
            end
        end

        if aimOn then
            if aimPartMode == "Silent" and silentGetTarget then
                local c = silentGetTarget(Camera.CFrame.Position)
                if c then
                    StatusText.Text = "Aim: Đã ngắm (Silent-" .. silentPartMode .. ")"
                    StatusText.TextColor3 = Color3.fromRGB(60, 255, 60)
                else
                    StatusText.Text = "Aim: Chưa ngắm (Silent-" .. silentPartMode .. ")"
                    StatusText.TextColor3 = Color3.fromRGB(255, 60, 60)
                end
            else
                local target = getClosestTarget()
                if target then
                    local targetPart = "Head"
                    if aimPartMode == "Body" then
                        targetPart = "UpperTorso"
                        if target:IsA("Player") and target.Character and not target.Character:FindFirstChild("UpperTorso") then
                            targetPart = "Torso"
                        end
                    else
                        targetPart = "Head"
                    end

                    local part = nil
                    if target:IsA("Player") then
                        if target.Character then
                            part = target.Character:FindFirstChild(targetPart)
                            if not part and targetPart ~= "Head" then
                                part = target.Character:FindFirstChild("Head")
                            end
                        end
                    else
                        part = target:FindFirstChild(targetPart)
                        if not part and targetPart ~= "Head" then
                            part = target:FindFirstChild("Head")
                        end
                    end

                    if part then
                        StatusText.Text = "Aim: Đã ngắm (" .. aimPartMode .. ")"
                        StatusText.TextColor3 = Color3.fromRGB(60, 255, 60)

                        local aimPos = part.Position + Vector3.new(0, aimOffsetY, 0)
                        local camPos = Camera.CFrame.Position
                        if INSTANT_AIM then
                            Camera.CFrame = CFrame.lookAt(camPos, aimPos)
                        else
                            local current = Camera.CFrame.LookVector
                            local desired = (aimPos - camPos).Unit
                            local newDir = current:Lerp(desired, 0.35).Unit
                            Camera.CFrame = CFrame.lookAt(camPos, camPos + newDir)
                        end

                        if autoShot then
                            if tick() - lastAutoShot >= autoShotInterval then
                                lastAutoShot = tick()
                                pcall(function()
                                    if player.Character then
                                        local tool = player.Character:FindFirstChildOfClass("Tool")
                                        if tool and tool.Parent then tool:Activate() end
                                    end
                                end)
                            end
                        end
                    end
                else
                    StatusText.Text = "Aim: Chưa ngắm (" .. aimPartMode .. ")"
                    StatusText.TextColor3 = Color3.fromRGB(255, 60, 60)
                end
            end
        else
            StatusText.Text = "Aim: OFF"
            StatusText.TextColor3 = Color3.fromRGB(255, 60, 60)
        end
    end)

